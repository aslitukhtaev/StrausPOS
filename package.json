{
  "name": "delfin-sauna",
  "productName": "Delfin Sauna",
  "version": "0.3.2",
  "description": "Delfin Sauna — sauna va dam olish maskanlari uchun offline kassa (POS) dasturi",
  "main": "out/main/index.cjs",
  "author": "Delfin Sauna",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "dev:server": "tsx scripts/dev-server.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "dist": "electron-vite build && electron-builder --win",
    "check:compat": "electron-vite build && node scripts/check-compat.mjs",
    "dist:x64": "electron-vite build && electron-builder --win nsis --x64",
    "dist:ia32": "electron-vite build && electron-builder --win nsis --ia32",
    "dist:dir": "electron-vite build && electron-builder --win dir --x64"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "acorn": "^8.18.0",
    "electron": "22.3.27",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "build": {
    "appId": "uz.delfin.sauna",
    "productName": "Delfin Sauna",
    "copyright": "© Delfin Sauna",
    "electronVersion": "22.3.27",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "out/**",
      "package.json",
      "!**/*.map",
      "!node_modules/sql.js/dist/!(sql-wasm.js|sql-wasm.wasm)",
      "!node_modules/{react,react-dom,scheduler,loose-envify,js-tokens,zustand}/**"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "publish": null,
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "artifactName": "DelfinSauna-${version}-${arch}.${ext}",
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Delfin Sauna",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "DelfinSauna-Setup-${version}-${arch}.${ext}",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}
