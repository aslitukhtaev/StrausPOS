# Faqat receive.php (dastur yuboradi) va cron.php (kalit bilan) veb orqali ochiq. Qolganlari yopiq.
<FilesMatch "^(lib|config|config\.example|selftest)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<FilesMatch "\.(json|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
